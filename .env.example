# =============================================================================
# حِساب (ERPCloud3) — نموذج ملف البيئة / environment template
#
# الاستخدام / usage:
#   cp .env.example .env      # ثم املأ القيم الفارغة
#
# القواعد / rules:
#   1) هذا الملف **لا يحتوي أي سرّ** — كل قيمة سرية تُترك فارغة هنا وتُملأ في .env
#      (أو في مخزن أسرار الخادم) و`.env` غير مُتتبَّع في Git.
#   2) لا تضع مفتاحًا أو كلمة مرور داخل واجهة النظام؛ الشاشات تطلب **اسم متغير البيئة** فقط.
#   3) سطر يبدأ بـ `#` = اختياري أو غير مُفعَّل. الأسطر الفعّالة هنا هي الإعداد التطويري الآمن.
#
# هذا الملف مُتحقَّق منه آليًا: tests/unit/env-example.test.ts يرفض أي متغير بيئة
# يُقرأ في src/ أو scripts/ ولا يوجد هنا، ويرفض أي قيمة سرية موضوعة في هذا الملف.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) أساسي — إلزامي / required
# -----------------------------------------------------------------------------

# اتصال PostgreSQL (15+). في الساندبوكس يعمل المحرّك المدمج على المنفذ 5432.
# PostgreSQL connection string. Example: postgresql://user:password@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# مفتاح التشفير (32 بايت: base64 أو 64 حرفًا سادس عشريًا). يُشفَّر به:
#   - المفتاح الخاص لـ ZATCA (CSR) والبيانات السرية للتكامل،
#   - ملفات النسخ الاحتياطي (.backups/*.enc).
# ⚠️ فقدانه = فقدان القدرة على فكّ النسخ الاحتياطية والتوقيع بالشهادات القائمة.
# توليده:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
HISAB_ENCRYPTION_KEY=

# مفاتيح سابقة أثناء تدوير المفتاح (مفصولة بفاصلة) — تُستخدم لفكّ النسخ القديمة فقط.
# Previous keys during rotation (comma-separated); decryption only.
# HISAB_ENCRYPTION_KEYS_OLD=

# المضيفون المسموح لهم بإرسال Server Actions (طلبات النماذج) — مفصولة بفاصلة.
# WHY: خلف وسيط (proxy) يختلف `Origin` العام عن المضيف الذي يراه التطبيق، ويرفض Next.js
# الطلب برسالة «Invalid Server Actions request.» — وهذا ما يُعطّل تسجيل الدخول في المعاينة.
# الافتراضي يغطي نطاق المعاينة؛ في نشر حقيقي ضع مضيفك هنا أو اعتمد على الطلبات
# ذات الأصل نفسه (لا حاجة لأي إدخال عند تمرير المضيف العام عبر الوسيط).
# Comma-separated hosts allowed to POST Server Actions (default: *.e2b.app,localhost:3000).
# HISAB_ALLOWED_ORIGINS=hisab.example.com

# -----------------------------------------------------------------------------
# 2) التشغيل / runtime
# -----------------------------------------------------------------------------

# true = تشغيل عامل المهام الخلفية (pg-boss: zatca-submission، النسخ الاحتياطي،
# الصيانة اليومية 01:15). اجعله false على المحرّك المدمج (لا يدعم LISTEN/NOTIFY).
ENABLE_WORKER=false

# أقصى عدد اتصالات في الحوض. اتركه صغيرًا مع المحرّك المدمج (اتصال واحد فعليًا).
PG_POOL_MAX=10

# debug | info | warn | error  (الافتراضي: debug خارج الإنتاج، info في الإنتاج)
LOG_LEVEL=info

# NODE_ENV و NEXT_RUNTIME تُضبَط تلقائيًا بواسطة Next.js — لا تضعها هنا.
# NODE_ENV / NEXT_RUNTIME are set by the framework; do not set them here.

# -----------------------------------------------------------------------------
# 3) التهيئة والبيانات التجريبية / seeding (للتطوير فقط)
# -----------------------------------------------------------------------------
# تُقرأ من scripts/seed.ts عند أول تهيئة. غيّرها قبل أي استخدام حقيقي.

SEED_PLATFORM_EMAIL=admin@hisab.sa
# ⚠️ ضع كلمة المرور بين علامتي تنصيص إذا احتوت `#` أو مسافة — وإلا فسيفسّرها القارئ
#    كتعليق ويُقتطع نصفها (هذا بالضبط ما يجعل تسجيل الدخول يفشل بلا سبب واضح).
# ⚠️ Quote the value whenever it contains `#` or spaces: dotenv treats a bare `#` as the start
#    of a comment, so `Hisab#2026` silently becomes `Hisab` — a login that cannot work.
# (القيمة التجريبية الافتراضية يكتبها `npm run env:setup` بين علامتي تنصيص:
#  "Hisab#2026" — تريد غيرها اكتبها هنا مُقتبَسة أيضًا.)
SEED_BOOTSTRAP_PASSWORD=
SEED_DEMO_PASSWORD=

# -----------------------------------------------------------------------------
# 4) المساعد الذكي / AI assistant
# -----------------------------------------------------------------------------
# اسم هذا المتغير هو ما يُدخَل في شاشة /assistant/settings («متغيّر بيئة المفتاح»)؛
# القيمة تُوضع هنا فقط ولا تُخزَّن في قاعدة البيانات ولا تُعرض في الواجهة.
# The *name* is what the settings screen stores; the value lives only here.
# ⚠️ لا يُطلب أي مزوّد من هذا الإصدار إلا عند التمكين من المنصة + المنشأة.
ASSISTANT_API_KEY=

# -----------------------------------------------------------------------------
# 5) الضريبة و ZATCA / tax & e-invoicing
# -----------------------------------------------------------------------------
# mock = محرّك محاكاة محلي يجري تحقّقًا حقيقيًا على البنية لكنه يُنتج نتائج مقبولة
#        (مسموح فقط في التطوير/الاختبار). اتركه فارغًا في أي بيئة إنتاج:
#        بدون بيانات اعتماد حقيقية يرفض النظام الإرسال ولا يلفّق نجاحًا.
# ZATCA_TRANSPORT=mock

# -----------------------------------------------------------------------------
# 6) النسخ الاحتياطي والاستعادة / backup & restore
# -----------------------------------------------------------------------------

# مجلد النسخ الاحتياطية (افتراضي .backups — مستثنى من Git)
# BACKUP_DIR=.backups

# مجلد حزم تصدير بيانات المنشآت (افتراضي .exports — مستثنى من Git)
# EXPORT_DIR=.exports

# مسار تنفيذي pg_dump إن لم يكن على PATH. عند غيابه يعمل النظام بالمسار المنطقي
# (logical-json) ويسجّل ذلك في backup_runs.format بدلًا من ادّعاء نسخة custom.
# PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump

# ⚠️ خطير: يسمح بالاستعادة الفعلية فوق قاعدة بيانات حيّة (backup.restore).
# يشترط أيضًا: قاعدة الشخصين + كتابة اسم قاعدة البيانات نصًّا + نسخة أمان قبلها.
# اتركه غير مُفعَّل إلا في نافذة صيانة معلنة.
# HISAB_ALLOW_LIVE_RESTORE=true

# رفع النسخ خارج الموقع (Google Drive). عند غياب أيٍّ منها يسجّل النظام المزوّد
# `local-contract` بصراحة — وهو نسخة محلية وليس تخزينًا خارج الموقع.
# Off-site upload (Drive). Without these the provider is labelled `local-contract`.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# -----------------------------------------------------------------------------
# 7) أدوات التطوير والفحص / dev & verification tooling
# -----------------------------------------------------------------------------

# منفذ وأقصى اتصالات قاعدة بيانات التطوير المدمجة (scripts/dev-postgres.mjs)
# PGLITE_PORT=5432
# PGLITE_MAX_CONNECTIONS=60

# عنوان الأساس لمسح القبول (npm run acceptance:sweep) — الافتراضي 127.0.0.1:3000
# ACCEPTANCE_BASE=http://127.0.0.1:3000
